# Staging only. Replace every placeholder with a staging-specific value.
NODE_ENV=production
MUNCH_APP_BASE_URL=https://munch-staging.example.com
MUNCH_RAILWAY_AUTH_ENABLED=true
MUNCH_RAILWAY_DATA_ENABLED=true
MUNCH_STRICT_STARTUP_VALIDATION=true
MUNCH_DB_POOL_SIZE=10
DATABASE_URL=${{Postgres.DATABASE_URL}}

MUNCH_SESSION_SECRET=<64-character-random-staging-secret>
MUNCH_LOGIN_DELIVERY_ENDPOINT=https://<staging-mail-adapter>/deliver
MUNCH_LOGIN_DELIVERY_SECRET=<independent-staging-secret>
MUNCH_DEV_EXPOSE_LOGIN_LINK=false

STRIPE_SECRET_KEY=sk_test_<staging>
STRIPE_WEBHOOK_SECRET=whsec_<staging>
STRIPE_PRICE_ID=price_<staging>

OFF_USER_AGENT=Munch Staging (support@example.com)
USDA_FDC_API_KEY=<staging-usda-key>

ALLOWED_ORIGINS=https://munch-staging.example.com
PORT=8080

# Supply only in a restricted shell when running the authenticated contract probe.
# Never store an access token in Railway variables or this file.
# MUNCH_CERT_ACCESS_TOKEN=<ephemeral-staging-access-token>
