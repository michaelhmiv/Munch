# Canonical Munch runtime: Railway PostgreSQL + Better Auth only.
DATABASE_URL=postgresql://postgres:password@localhost:5432/munch
MUNCH_DB_POOL_SIZE=10

# Public origin used for account, billing, OAuth, exports, callbacks, and the
# OpenAI Apps Directory domain challenge.
MUNCH_APP_BASE_URL=http://localhost:8080
OPENAI_APPS_CHALLENGE=
ALLOWED_ORIGINS=

# Better Auth. Generate at least 32 random characters and keep this secret
# independent from Stripe, Resend, and database credentials.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MUNCH_AUTH_DB_POOL_SIZE=5
MUNCH_MAGIC_LINK_TTL_SECONDS=600

# Scanner-safe magic-link delivery through Resend.
RESEND_API_KEY=re_replace_me
MUNCH_EMAIL_FROM=Munch <sign-in@example.com>

# Stripe Billing. Checkout lives on the Munch website; ChatGPT does not surface
# subscription upsells during connector authentication.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_HOUSEHOLD_MEMBER_PRICE_ID=price_household_member_replace_me

# Food providers.
OFF_USER_AGENT=Munch (you@example.com)
USDA_FDC_API_KEY=replace-me

# Persistent Railway PostgreSQL food catalog. Historical meal snapshots are
# immutable and are never refreshed from catalog records.
MUNCH_FOOD_CATALOG_READS_ENABLED=true
MUNCH_FOOD_CATALOG_WRITES_ENABLED=true
MUNCH_FOOD_CATALOG_STALE_ON_ERROR=true
MUNCH_FOOD_CATALOG_PACKAGED_TTL_DAYS=90
MUNCH_FOOD_CATALOG_GENERIC_TTL_DAYS=180
MUNCH_FOOD_CATALOG_SEARCH_TTL_DAYS=3
MUNCH_FOOD_CATALOG_NEGATIVE_TTL_DAYS=1

PORT=8080
