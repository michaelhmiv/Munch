{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "munch": {
            "type": "streamable-http",
            "url": "https://munch.business/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": { "mode": "dcr" },
                        "baseScopes": [
                            "nutrition.read",
                            "nutrition.write",
                            "offline_access"
                        ]
                    }
                }
            }
        }
    }
}
